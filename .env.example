# Copie este arquivo para .env e preencha com os valores do seu ambiente.
# Não commite o arquivo .env.

DATABASE_URL=jdbc:postgresql://localhost:5432/petservicehub
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=altere-esta-senha

# Use uma string aleatória com pelo menos 32 caracteres.
JWT_SECRET=altere-este-segredo-jwt-com-pelo-menos-32-chars
JWT_EXPIRATION_MS=3600000
